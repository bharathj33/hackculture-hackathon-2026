# StoryCritic backend config — copy to .env
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
ZEP_API_KEY=...
MIROFISH_BASE_URL=http://localhost:5001
DATABASE_URL=sqlite:///./storycritic.db
# Session-scoped content retention (NFR-7): raw story content purged after this many minutes
CONTENT_TTL_MINUTES=120
# Editor JWT auth (public hosting). Empty JWT_SECRET = auth disabled (local dev).
JWT_SECRET=change-me-long-random-string
JWT_EXPIRY_HOURS=12
# Editor accounts, bcrypt-hashed at startup (plaintext never stored): "user1:pass1,user2:pass2"
AUTH_USERS=editor1:change-me,editor2:change-me
