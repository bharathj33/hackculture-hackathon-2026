# StoryCritic backend config — copy to .env
OPENAI_API_KEY=sk-...
ELEVENLABS_API_KEY=...
ZEP_API_KEY=...
MIROFISH_BASE_URL=http://localhost:5001
DATABASE_URL=sqlite:///./storycritic.db
# Session-scoped content retention (NFR-7): raw story content purged after this many minutes
CONTENT_TTL_MINUTES=120
# Store uploads (audio/video/text) in the Unity Catalog Volume storycritic.raw.uploads.
# Needs DATABRICKS_HOST/TOKEN. Blobs are deleted by the same TTL sweep as raw_text.
MIRROR_RAW_CONTENT=true
DATABRICKS_HOST=https://...cloud.databricks.com
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=...
# Editor JWT auth (public hosting). Leave JWT_SECRET empty for local testing (auth off).
JWT_SECRET=
JWT_EXPIRY_HOURS=12
# Editor accounts, bcrypt-hashed at startup: "user1:pass1,user2:pass2". Leave empty with JWT_SECRET for open local dev.
AUTH_USERS=
