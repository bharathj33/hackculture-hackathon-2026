# Simulation service only — MiroFish's Flask backend (OASIS swarm + Zep).
# Its own Dockerfile builds the Node UI too and runs `npm run dev`; StoryCritic
# only ever calls the HTTP API, so none of that is needed here.
FROM python:3.11-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends build-essential \
  && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/

WORKDIR /app

COPY backend/pyproject.toml backend/uv.lock ./
RUN uv sync --frozen --no-dev

COPY backend/ ./
# app/utils/locale.py resolves ../../../locales relative to /app/app/utils -> /locales
COPY locales/ /locales/

ENV FLASK_HOST=0.0.0.0
# run.py reads FLASK_PORT; Railway injects PORT. Shell form so it expands.
CMD FLASK_PORT=${PORT:-5001} uv run python run.py
